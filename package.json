{
  "name": "hackbook",
  "private": true,
  "version": "1.0.0",
  "description": "A comprehensive suite of browser-based offensive security tools for CTF players, pentesters, and security researchers",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Thongheng/HackBook.git"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "checklist:validate": "python3 scripts/validate_checklist_catalog.py",
    "checklist:scenarios": "node scripts/validate_checklist_scenarios.mjs",
    "checklist:matrix": "node scripts/validate_checklist_matrix.mjs",
    "checklist:export-shape": "node scripts/validate_checklist_export.mjs",
    "checklist:review-html": "node scripts/validate_checklist_review_html.mjs",
    "checklist:review-html:export": "node scripts/export_checklist_review_html.mjs",
    "checklist:test": "npm run checklist:validate && npm run checklist:scenarios && npm run checklist:matrix && npm run checklist:export-shape && npm run checklist:review-html"
  },
  "dependencies": {
    "cfb": "^1.2.2",
    "lucide-react": "^0.563.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
